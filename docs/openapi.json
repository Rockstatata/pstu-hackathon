    "/api/v1/health/live": {
      "get": {
        "description": "Is this process running? Deliberately does not touch the database.\n\nA liveness probe that fails when Postgres is down would have the orchestrator\nrestart three healthy API replicas during a database blip, turning one outage\ninto two.",
        "operationId": "liveness_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
